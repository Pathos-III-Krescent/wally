# Copy this file to .env and fill it in. Never commit .env.
# See REGISTRY_SETUP.md for where each value comes from.

# Who can read and publish. Keep this on one line.
WALLY_auth={type="github-org",value={client-id="YOUR_OAUTH_CLIENT_ID",client-secret="YOUR_OAUTH_CLIENT_SECRET",org="Pathos-III-Krescent",publisher-team="wally-publishers"}}

# Fine-grained GitHub token: write access to wally-index, read access to org members.
WALLY_github_token=github_pat_REPLACE_ME

# Optional: lets CI publish (but not download). Generate with `openssl rand -hex 32`.
WALLY_ci_publish_key=

# Optional, temporary: the old shared API key, so nobody breaks during the switch.
# Delete this line once everyone has run `wally login`.
WALLY_legacy_api_key=

# Optional: Discord webhook for publishes and denied requests.
WALLY_audit_webhook=
